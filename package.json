{
  "name": "skills-dashboard",
  "productName": "Skills Dashboard",
  "version": "0.1.0",
  "description": "Browse, edit, link and pack every Claude skill on this machine.",
  "author": "AlexMtz",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uiw/react-codemirror": "4.25.12",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
